{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "assignees": ["Citizenfive"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "L'app manipule les fenêtres de Tauri avec gtk et webkit2gtk : elles doivent rester aux versions de Tauri et se mettent à jour avec lui",
      "matchFileNames": ["desktop/Cargo.toml"],
      "matchPackageNames": ["gtk", "webkit2gtk"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "tauri-cli utilisé par la release pour fabriquer l'app de bureau",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": [
        "TAURI_CLI_VERSION: (?<currentValue>\\S+) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    },
    {
      "description": "Greffon AppImage figé dans desktop/appimage-tools.txt (son SHA-256 se met à jour à la main : ./appimage-tools.sh update)",
      "customType": "regex",
      "managerFilePatterns": ["/^desktop/appimage-tools\\.txt$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>linuxdeploy/linuxdeploy-plugin-appimage)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^1-alpha-(?<major>\\d+)-(?<minor>\\d+)$"
    }
  ]
}
