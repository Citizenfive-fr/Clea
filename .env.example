# PostgreSQL
DATABASE_URL=postgresql://clea:change_me@localhost:5432/clea
POSTGRES_PASSWORD=change_me

# App — clé de chiffrement des secrets 2FA (32 caractères minimum, sinon Cléa refuse de démarrer).
# Générer avec : openssl rand -hex 64
# À sauvegarder à part de la base de données. Si elle est perdue ou modifiée,
# les secrets 2FA deviennent illisibles et les 2FA doivent être réinitialisés.
APP_SECRET_KEY=change_me

# Sessions (heures)
SESSION_DURATION_HOURS=24
INVITATION_DURATION_HOURS=72

# Mettre à true en production (HTTPS obligatoire)
SECURE_COOKIES=false

# À mettre à true uniquement derrière un reverse proxy (Caddy, nginx...) qui ajoute
# X-Forwarded-For, avec le port de Cléa accessible seulement depuis le proxy.
# Sans proxy, laisser à false (sinon la limite de tentatives de login peut être contournée).
TRUST_PROXY=false
