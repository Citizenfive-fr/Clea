# PostgreSQL
DATABASE_URL=postgresql://clea:change_me@localhost:5432/clea
POSTGRES_PASSWORD=change_me

# App : clé maîtresse (64 caractères hexadécimaux minimum, sinon Cléa refuse de démarrer).
# Elle enferme les clés de chiffrement des organisations. Tu peux aussi la mettre dans un
# fichier et indiquer son chemin avec APP_KEY_FILE (prioritaire sur APP_SECRET_KEY).
# Générer avec : openssl rand -hex 64
# À sauvegarder à part de la base de données. Si elle est perdue, seule la clé de secours
# affichée au setup permet de tout récupérer (commande clea recover, voir le README).
# Pour en changer : clea rotate-key (la modifier ici directement empêche Cléa de démarrer).
APP_SECRET_KEY=change_me

# Sessions (heures)
SESSION_DURATION_HOURS=24
INVITATION_DURATION_HOURS=72

# Mettre à true en production (HTTPS obligatoire)
SECURE_COOKIES=false

# À mettre à true uniquement derrière un reverse proxy (Caddy, nginx...) qui ajoute
# X-Forwarded-For, avec le port de Cléa accessible seulement depuis le proxy.
# Sans proxy, laisser à false (sinon la limite de tentatives de login peut être contournée).
TRUST_PROXY=false
